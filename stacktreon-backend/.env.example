# Server
PORT=3000

# Postgres connection string (Neon, Supabase, or local)
DATABASE_URL=postgresql://username:password@localhost:5432/stacktreon

# Frontend origin allowed by CORS (localhost:5173 and :8080 are always allowed)
FRONTEND_URL=http://localhost:5173

# Stacks network used for x402 payment verification: testnet | mainnet
NETWORK=testnet

# x402 facilitator that verifies STX payments
FACILITATOR_URL=https://facilitator.stacksx402.com

# Supabase Storage (content uploads and signed URLs)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_BUCKET=stacktreon
